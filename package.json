{
  "name": "envkeep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "envkeep": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "cli": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
